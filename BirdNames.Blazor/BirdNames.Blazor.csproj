  </ItemGroup>

  <ItemGroup>
    <Folder Include="Files\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="temp\_placeholder.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="temp\_placeholder.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
